# Ethernet GMII/MDIO and PHY reset pins from SCU200_SCH_20260724.xdc.
# These signals use Bank 41, whose VCCO is 1.8 V.
set_property PACKAGE_PIN AJ14 [get_ports {eth0_gmii_0_txd[6]}]
set_property PACKAGE_PIN AH14 [get_ports {eth0_gmii_0_txd[7]}]
set_property PACKAGE_PIN AH12 [get_ports {eth0_gmii_0_txd[4]}]
set_property PACKAGE_PIN AG13 [get_ports {eth0_gmii_0_txd[5]}]
set_property PACKAGE_PIN AH10 [get_ports {eth0_gmii_0_txd[2]}]
set_property PACKAGE_PIN AH11 [get_ports {eth0_gmii_0_txd[3]}]
set_property PACKAGE_PIN AL11 [get_ports {eth0_gmii_0_txd[0]}]
set_property PACKAGE_PIN AK11 [get_ports {eth0_gmii_0_txd[1]}]
set_property PACKAGE_PIN AM10 [get_ports {eth0_gmii_0_rxd[7]}]
set_property PACKAGE_PIN AM9  [get_ports {eth0_gmii_0_rxd[6]}]
set_property PACKAGE_PIN AE14 [get_ports {eth0_gmii_0_rxd[4]}]
set_property PACKAGE_PIN AE15 [get_ports {eth0_gmii_0_rxd[5]}]
set_property PACKAGE_PIN AF13 [get_ports {eth0_gmii_0_rxd[2]}]
set_property PACKAGE_PIN AE13 [get_ports {eth0_gmii_0_rxd[3]}]
set_property PACKAGE_PIN AF12 [get_ports {eth0_gmii_0_rxd[0]}]
set_property PACKAGE_PIN AE12 [get_ports {eth0_gmii_0_rxd[1]}]
set_property PACKAGE_PIN AJ15 [get_ports eth0_gmii_0_tx_en]
set_property PACKAGE_PIN AH16 [get_ports eth0_gmii_0_tx_er]
set_property PACKAGE_PIN AJ13 [get_ports eth0_gmii_0_rx_dv]
set_property PACKAGE_PIN AJ12 [get_ports eth0_gmii_0_rx_er]
set_property PACKAGE_PIN AJ10 [get_ports eth0_gmii_0_gtx_clk]
set_property PACKAGE_PIN AD15 [get_ports eth0_gmii_0_tx_clk]
set_property PACKAGE_PIN AD17 [get_ports eth0_gmii_0_rx_clk]
set_property PACKAGE_PIN AL12 [get_ports eth0_mdio_0_mdc]
set_property PACKAGE_PIN AM13 [get_ports eth0_mdio_0_mdio_io]
set_property PACKAGE_PIN AG14 [get_ports {eth0_phy_rst_n[0]}]

set_property IOSTANDARD LVCMOS18 [get_ports {eth0_gmii_0_txd[*]}]
set_property IOSTANDARD LVCMOS18 [get_ports {eth0_gmii_0_rxd[*]}]
set_property IOSTANDARD LVCMOS18 [get_ports {eth0_gmii_0_tx_en eth0_gmii_0_tx_er}]
set_property IOSTANDARD LVCMOS18 [get_ports {eth0_gmii_0_rx_dv eth0_gmii_0_rx_er}]
set_property IOSTANDARD LVCMOS18 [get_ports {eth0_gmii_0_gtx_clk eth0_gmii_0_tx_clk eth0_gmii_0_rx_clk}]
set_property IOSTANDARD LVCMOS18 [get_ports {eth0_mdio_0_mdc eth0_mdio_0_mdio_io}]
set_property IOSTANDARD LVCMOS18 [get_ports {eth0_phy_rst_n[0]}]
